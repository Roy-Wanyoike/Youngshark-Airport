{
  "name": "youngshark-airport",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd apps/api && npm install --no-audit --no-fund && npm run build",
    "build:web": "cd apps/web && npm install --no-audit --no-fund && npm run build",
    "dev": "cd apps/web && npm start"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "joi": "^17.7.0",
    "jsonwebtoken": "^9.0.0",
    "mssql": "^9.1.1",
    "nodemailer": "^6.9.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.11.0",
    "@vercel/node": "^5.1.0",
    "typescript": "^5.4.0"
  }
}
