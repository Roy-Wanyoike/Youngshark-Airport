{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist/airport/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/emails", "schedule": "*/10 * * * *" }
  ]
}
