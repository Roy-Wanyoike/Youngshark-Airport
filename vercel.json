{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "angular",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/airport/browser",
      "installCommand": "npm install"
    },
    "api": {
      "root": "apps/api",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "dist",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    { "source": "/api/auth/(.*)",     "destination": { "service": "api" } },
    { "source": "/api/flights(.*)",   "destination": { "service": "api" } },
    { "source": "/api/cron/(.*)",     "destination": { "service": "api" } },
    { "source": "/api/health",        "destination": { "service": "api" } }
  ],
  "crons": [
    { "path": "/api/cron/emails", "schedule": "*/10 * * * *" }
  ]
}
