# Backend (Express + SQL Server) environment variables.
#
# Copy to `.env` and fill in. For Vercel, set these in the project's
# Environment Variables settings (or via `vercel env`).
#
# Database host. For docker-compose use `db`; for Azure SQL use
# `<server>.database.windows.net`.
DB_HOST=db
DB_PORT=1433
DB_USER=sa
DB_PWD=Your_password123
DB_NAME=AirportDB

# Set to "true" when connecting to Azure SQL (requires TLS).
DB_ENCRYPT=false
# Set to "true" for local dev with a self-signed cert.
DB_TRUST=true

# JWT signing secret — use a long random string in production.
SECRETKEY=dev-secret-change-me
