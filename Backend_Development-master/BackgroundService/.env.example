# Background email service environment variables.
#
# Same DB variables as the backend, plus SMTP credentials.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PWD=Your_password123
DB_NAME=AirportDB
DB_ENCRYPT=false
DB_TRUST=true

# Gmail SMTP credentials (or any SMTP server — update Helpers/email.ts if different).
EMAIL=you@gmail.com
PASSWORD=your-app-password
